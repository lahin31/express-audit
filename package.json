{
  "name": "express-audit",
  "version": "0.1.9",
  "description": "Deterministic security and production readiness auditor for Express.js applications.",
  "author": "Muhammad Lahin",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "express-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahin31/express-audit.git"
  },
  "homepage": "https://github.com/lahin31/express-audit#readme",
  "bugs": {
    "url": "https://github.com/lahin31/express-audit/issues"
  },
  "keywords": [
    "express",
    "expressjs",
    "security",
    "audit",
    "security-audit",
    "static-analysis",
    "ast",
    "babel",
    "owasp",
    "jwt",
    "oauth",
    "casa",
    "sarif",
    "cli",
    "node",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate-version": "node scripts/generate-version.mjs",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "tsc",
    "dev": "node scripts/generate-version.mjs && tsc --watch",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build",
    "release:patch": "standard-version --release-as patch && git push --follow-tags && npm publish",
    "release:minor": "standard-version --release-as minor && git push --follow-tags && npm publish",
    "release:major": "standard-version --release-as major && git push --follow-tags && npm publish"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.10",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
